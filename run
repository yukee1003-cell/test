import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import pandas as pd
from matplotlib import font_manager
from matplotlib.font_manager import FontProperties
import matplotlib
import platform
import os

# 清除matplotlib字体缓存并重新加载
try:
    import shutil
    cache_dir = matplotlib.get_cachedir()
    import glob
    # 查找所有字体缓存文件
    cache_patterns = [
        os.path.join(cache_dir, 'fontlist-v*.json'),
        os.path.join(cache_dir, 'fontlist-v*.pickle'),
        os.path.join(cache_dir, 'tex.cache'),
    ]
    for pattern in cache_patterns:
        cache_files = glob.glob(pattern)
        for cache_file in cache_files:
            try:
                os.remove(cache_file)
                print(f"已删除字体缓存: {cache_file}")
            except:
                pass
    # 重新构建字体管理器（如果方法存在）
    try:
        if hasattr(font_manager, '_rebuild'):
            font_manager._rebuild()
        elif hasattr(font_manager.fontManager, 'addfont'):
            # 尝试其他方法
            pass
        print("字体缓存已清除")
    except:
        pass
except Exception as e:
    print(f"清除字体缓存时出错: {e}")

# 设置中文字体 - 使用Windows字体文件路径
system = platform.system()
chinese_font_path = None
chinese_font_name = None

if system == 'Windows':
    # Windows系统字体文件路径
    font_paths = [
        r'C:\Windows\Fonts\msyh.ttc',  # 微软雅黑
        r'C:\Windows\Fonts\simhei.ttf',  # 黑体
        r'C:\Windows\Fonts\simsun.ttc',  # 宋体
        r'C:\Windows\Fonts\msyhbd.ttc',  # 微软雅黑 Bold
    ]
    font_names = ['Microsoft YaHei', 'SimHei', 'SimSun', 'Microsoft YaHei']
    
    # 查找可用的字体文件
    for font_path, font_name in zip(font_paths, font_names):
        if os.path.exists(font_path):
            chinese_font_path = font_path
            chinese_font_name = font_name
            print(f"找到中文字体文件: {font_path}")
            break
    
    # 如果找到字体文件，直接使用文件路径
    if chinese_font_path:
        # 方法1: 使用FontProperties全局设置
        prop = FontProperties(fname=chinese_font_path)
        plt.rcParams['font.family'] = prop.get_name()
        plt.rcParams['font.sans-serif'] = [prop.get_name(), 'SimHei', 'Microsoft YaHei', 'SimSun']
        print(f"使用字体: {prop.get_name()}")
    else:
        # 方法2: 使用字体名称
        plt.rcParams['font.sans-serif'] = ['Microsoft YaHei', 'SimHei', 'SimSun', 'KaiTi']
        print("使用字体名称: Microsoft YaHei")
        
elif system == 'Darwin':
    plt.rcParams['font.sans-serif'] = ['Arial Unicode MS', 'PingFang SC', 'STHeiti']
else:
    plt.rcParams['font.sans-serif'] = ['WenQuanYi Micro Hei', 'Noto Sans CJK SC', 'DejaVu Sans']

plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题

# 如果找到了字体文件，创建一个全局的FontProperties对象供后续使用
if chinese_font_path:
    chinese_font_prop = FontProperties(fname=chinese_font_path)
else:
    chinese_font_prop = None

# 设置图表样式
sns.set_style("whitegrid")
sns.set_palette("husl")

# 表1数据：水电出力与负荷相关系数
data_table1 = {
    '区域': ['上海', '浙江', '江苏', '三省合计'],
    '水电_vs_净负荷_日': [0.6551, 0.6420, 0.6394, 0.6661],
    '水电_vs_电网负荷_日': [0.6612, 0.6719, 0.6871, 0.6952],
    '水电_vs_净负荷_旬': [0.6780, 0.6657, 0.6869, 0.6967],
    '水电_vs_电网负荷_旬': [0.6840, 0.6909, 0.7113, 0.7161],
    '水电_vs_净负荷_月': [0.6916, 0.6951, 0.7161, 0.7226],
    '水电_vs_电网负荷_月': [0.6977, 0.7142, 0.7329, 0.7363]
}

# 表2数据：差值比较
data_table2 = {
    '区域': ['上海', '浙江', '江苏', '三省合计'],
    '日尺度差值': [0.0061, 0.0299, 0.0477, 0.0291],
    '旬尺度差值': [0.0060, 0.0252, 0.0244, 0.0194],
    '月尺度差值': [0.0061, 0.0191, 0.0168, 0.0137]
}

# 创建DataFrame
df1 = pd.DataFrame(data_table1)
df2 = pd.DataFrame(data_table2)

regions = df1['区域']
time_scales = ['日', '旬', '月']
region_palette = sns.color_palette("Set2", len(regions))

# 准备热力图数据，并优化指标命名便于展示
heatmap_data = df1.set_index('区域').T
heatmap_data.columns.name = '区域'
heatmap_data.index.name = '指标'
metric_label_map = {
    '水电_vs_净负荷_日': '净负荷-日',
    '水电_vs_电网负荷_日': '电网负荷-日',
    '水电_vs_净负荷_旬': '净负荷-旬',
    '水电_vs_电网负荷_旬': '电网负荷-旬',
    '水电_vs_净负荷_月': '净负荷-月',
    '水电_vs_电网负荷_月': '电网负荷-月'
}
heatmap_data.index = heatmap_data.index.map(lambda x: metric_label_map.get(x, x))


def apply_font_to_labels(labels):
    """为文本标签统一设置中文字体。"""
    if not chinese_font_prop:
        return
    for label in labels:
        label.set_fontproperties(chinese_font_prop)


def set_axis_text(ax, title=None, xlabel=None, ylabel=None, title_size=14, label_size=12):
    """统一设置图表标题与坐标轴文本。"""
    if title:
        if chinese_font_prop:
            ax.set_title(title, fontsize=title_size, fontweight='bold', pad=15, fontproperties=chinese_font_prop)
        else:
            ax.set_title(title, fontsize=title_size, fontweight='bold', pad=15)
    if xlabel:
        if chinese_font_prop:
            ax.set_xlabel(xlabel, fontsize=label_size, fontproperties=chinese_font_prop)
        else:
            ax.set_xlabel(xlabel, fontsize=label_size)
    if ylabel:
        if chinese_font_prop:
            ax.set_ylabel(ylabel, fontsize=label_size, fontproperties=chinese_font_prop)
        else:
            ax.set_ylabel(ylabel, fontsize=label_size)


def format_tick_labels(ax):
    """统一美化坐标轴刻度标签。"""
    ax.tick_params(axis='x', labelsize=11)
    ax.tick_params(axis='y', labelsize=11)
    if not chinese_font_prop:
        return
    apply_font_to_labels(list(ax.get_xticklabels()) + list(ax.get_yticklabels()))


def plot_heatmap(ax):
    """绘制热力图并修复刻度文字显示。"""
    heatmap = sns.heatmap(
        heatmap_data,
        annot=True,
        fmt='.4f',
        cmap='YlOrRd',
        cbar_kws={'label': '相关系数'},
        ax=ax,
        linewidths=0.5,
        linecolor='gray',
        vmin=0.63,
        vmax=0.74
    )
    set_axis_text(ax, '水电出力与负荷相关系数热力图', '区域', '指标', title_size=16)
    for label in ax.get_xticklabels():
        label.set_rotation(0)
    for label in ax.get_yticklabels():
        label.set_rotation(0)
        label.set_horizontalalignment('right')
    format_tick_labels(ax)
    cbar = heatmap.collections[0].colorbar if heatmap.collections else None
    if cbar and chinese_font_prop:
        cbar.set_label('相关系数', fontproperties=chinese_font_prop)
        apply_font_to_labels(cbar.ax.get_yticklabels())
    return ax


def plot_time_scale_trend(ax):
    """绘制不同时间尺度下的相关系数变化趋势。"""
    x_pos = np.arange(len(time_scales))
    for i, region in enumerate(regions):
        net_values = [
            df1.loc[i, '水电_vs_净负荷_日'],
            df1.loc[i, '水电_vs_净负荷_旬'],
            df1.loc[i, '水电_vs_净负荷_月']
        ]
        grid_values = [
            df1.loc[i, '水电_vs_电网负荷_日'],
            df1.loc[i, '水电_vs_电网负荷_旬'],
            df1.loc[i, '水电_vs_电网负荷_月']
        ]
        ax.plot(
            x_pos, net_values, marker='o', linewidth=2, markersize=7,
            linestyle='--', label=f'{region}-净负荷', color=region_palette[i]
        )
        ax.plot(
            x_pos, grid_values, marker='s', linewidth=2, markersize=7,
            linestyle='-', label=f'{region}-电网负荷', color=region_palette[i]
        )
    ax.set_xticks(x_pos)
    ax.set_xticklabels(time_scales)
    ax.set_ylim(0.63, 0.74)
    ax.grid(True, alpha=0.3, linestyle='--')
    set_axis_text(ax, '不同时间尺度下的相关系数变化趋势', '时间尺度', '相关系数', title_size=14)
    legend = ax.legend(
        ncol=2,
        fontsize=9,
        loc='upper center',
        bbox_to_anchor=(0.5, 1.25),
        frameon=False
    )
    if legend:
        apply_font_to_labels(legend.get_texts())
    format_tick_labels(ax)
    return ax


def plot_region_bars(ax):
    """绘制区域对比柱状图。"""
    x = np.arange(len(regions))
    metrics = [
        ('水电_vs_净负荷_日', '净负荷-日'),
        ('水电_vs_电网负荷_日', '电网负荷-日'),
        ('水电_vs_净负荷_旬', '净负荷-旬'),
        ('水电_vs_电网负荷_旬', '电网负荷-旬'),
        ('水电_vs_净负荷_月', '净负荷-月'),
        ('水电_vs_电网负荷_月', '电网负荷-月')
    ]
    width = 0.12
    palette = sns.color_palette("husl", len(metrics))
    offset = width * (len(metrics) - 1) / 2
    for idx, (col, label) in enumerate(metrics):
        values = df1[col].values
        ax.bar(
            x - offset + idx * width,
            values,
            width,
            label=label,
            color=palette[idx],
            alpha=0.9,
            edgecolor='white',
            linewidth=0.4
        )
    ax.set_xticks(x)
    ax.set_xticklabels(regions)
    ax.set_ylim(0.62, 0.75)
    ax.grid(True, alpha=0.3, axis='y', linestyle='--')
    set_axis_text(ax, '各区域不同指标相关系数对比', '区域', '相关系数', title_size=14)
    legend = ax.legend(
        ncol=3,
        fontsize=8,
        loc='upper center',
        bbox_to_anchor=(0.5, -0.25),
        frameon=False
    )
    if legend:
        apply_font_to_labels(legend.get_texts())
    format_tick_labels(ax)
    return ax


def plot_diff_bars(ax):
    """绘制差值比较柱状图。"""
    x = np.arange(len(regions))
    diff_metrics = ['日尺度差值', '旬尺度差值', '月尺度差值']
    diff_colors = ['#FF6B6B', '#4ECDC4', '#45B7D1']
    width = 0.22
    offset = width
    for idx, metric in enumerate(diff_metrics):
        values = df2[metric].values
        ax.bar(
            x - offset + idx * width,
            values,
            width,
            label=metric,
            color=diff_colors[idx],
            alpha=0.85,
            edgecolor='black',
            linewidth=0.8
        )
    ax.set_xticks(x)
    ax.set_xticklabels(regions)
    ax.grid(True, alpha=0.3, axis='y', linestyle='--')
    ax.axhline(y=0, color='black', linestyle='-', linewidth=0.8)
    set_axis_text(ax, '电网负荷与净负荷相关系数差值比较', '区域', '差值 (电网负荷 - 净负荷)', title_size=14)
    legend = ax.legend(fontsize=10, frameon=False)
    if legend:
        apply_font_to_labels(legend.get_texts())
    format_tick_labels(ax)
    return ax


def plot_diff_trend(ax):
    """绘制差值随时间尺度变化趋势折线图。"""
    for i, region in enumerate(regions):
        diff_values = [
            df2.loc[i, '日尺度差值'],
            df2.loc[i, '旬尺度差值'],
            df2.loc[i, '月尺度差值']
        ]
        ax.plot(
            time_scales,
            diff_values,
            marker='o',
            linewidth=2.5,
            markersize=8,
            label=region,
            color=region_palette[i]
        )
    ax.grid(True, alpha=0.3, linestyle='--')
    ax.axhline(y=0, color='black', linestyle='--', linewidth=1, alpha=0.5)
    set_axis_text(ax, '差值随时间尺度的变化趋势', '时间尺度', '差值 (电网负荷 - 净负荷)', title_size=14)
    legend = ax.legend(fontsize=10, frameon=False, loc='upper right')
    if legend:
        apply_font_to_labels(legend.get_texts())
    format_tick_labels(ax)
    return ax


# 创建排版更佳的总览图
fig = plt.figure(figsize=(20, 12))
gs = fig.add_gridspec(3, 2, hspace=0.4, wspace=0.35)

ax1 = fig.add_subplot(gs[0, :])
plot_heatmap(ax1)

ax2 = fig.add_subplot(gs[1, 0])
plot_time_scale_trend(ax2)

ax3 = fig.add_subplot(gs[1, 1])
plot_region_bars(ax3)

ax4 = fig.add_subplot(gs[2, 0])
plot_diff_bars(ax4)

ax5 = fig.add_subplot(gs[2, 1])
plot_diff_trend(ax5)

if chinese_font_prop:
    fig.suptitle('水电出力与负荷相关性分析可视化', fontsize=18, fontweight='bold', y=0.98, fontproperties=chinese_font_prop)
else:
    fig.suptitle('水电出力与负荷相关性分析可视化', fontsize=18, fontweight='bold', y=0.98)

fig.tight_layout(rect=[0, 0, 1, 0.96])
fig.savefig('水电负荷相关性分析.png', dpi=300, bbox_inches='tight', facecolor='white')
print("综合可视化图表已保存为：水电负荷相关性分析.png")

# 逐个生成并保存单图
single_plot_configs = [
    ('图1_水电出力与负荷相关系数热力图.png', plot_heatmap, (9, 6)),
    ('图2_不同时间尺度相关系数趋势.png', plot_time_scale_trend, (8, 5.5)),
    ('图3_各区域指标相关系数对比.png', plot_region_bars, (10, 6)),
    ('图4_相关系数差值比较.png', plot_diff_bars, (8, 5.5)),
    ('图5_差值变化趋势.png', plot_diff_trend, (8, 5.5))
]

for filename, plot_func, figsize in single_plot_configs:
    single_fig, single_ax = plt.subplots(figsize=figsize)
    plot_func(single_ax)
    single_fig.tight_layout()
    single_fig.savefig(filename, dpi=300, bbox_inches='tight', facecolor='white')
    plt.close(single_fig)
    print(f"已单独保存：{filename}")

# 显示总览图
plt.show()

